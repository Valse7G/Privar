+      continue;
+    }
+    const outcome = await checkReceiptOutcome(op.txHash);
+    if (outcome !== "unknown") {
+      finalizeOp(address, op.opId, outcome);
+      resolved++;
+    }
+    // outcome === "unknown" -> still genuinely pending, or RPC hiccup —
+    // leave it locked, try again on the next pass. Never force a guess.
+  }
+  return { resolved };
+}
