# ════════════════════════════════════════════════════════════════════════════
#  PrivARC v2.3.0 — Environment Variables
#  Copy to .env and fill in your values before deploying.
# ════════════════════════════════════════════════════════════════════════════

# ── Deployer ─────────────────────────────────────────────────────────────────
# Private key of the wallet that will deploy and hold DEFAULT_ADMIN_ROLE
# Fund it via: https://faucet.circle.com  (1 USDC/day for gas)
PRIVATE_KEY=0x...

# ── Multisig addresses (optional — defaults to deployer) ─────────────────────
# ADMIN_MULTISIG=0x...
# GUARDIAN_MULTISIG=0x...
# TREASURY_MULTISIG=0x...

# ── RPC endpoints ────────────────────────────────────────────────────────────
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# ── Token addresses ──────────────────────────────────────────────────────────
# Arc native USDC — do not change
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# EURC and cirBTC — set when Circle publishes official Arc Testnet addresses
# Until then, leave commented out (bridge/swap panels will show unavailable notice)
# EURC_ADDRESS=0x...
# CIRBTC_ADDRESS=0x...

# ── CCTP ─────────────────────────────────────────────────────────────────────
CCTP_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA

# ── Block explorer (ARCScan) ─────────────────────────────────────────────────
ARCSCAN_API_KEY=no-key-needed

# ── Gas reporting (optional) ─────────────────────────────────────────────────
REPORT_GAS=false
